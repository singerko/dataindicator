<?xml version="1.0" encoding="utf-8"?>
<!--
  Štýly a témy aplikácie.
  Základná téma je MaterialComponents (kompatibilná s BottomNavigationView a MaterialButton).
-->
<resources>
    <!-- Základný štýl aplikácie -->
    <style name="AppTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
    </style>

    <!-- Štýl pre tlačidlá -->
    <style name="ButtonStyle" parent="Widget.MaterialComponents.Button">
        <item name="android:textColor">@color/white</item>
        <item name="android:layout_margin">@dimen/button_margin</item>
    </style>

    <!-- Štýl pre splash screen (bez action baru) -->
    <style name="SplashTheme" parent="Theme.MaterialComponents.Light.NoActionBar">
        <item name="colorPrimary">@color/colorPrimary</item>
        <item name="colorPrimaryDark">@color/colorPrimaryDark</item>
        <item name="colorAccent">@color/colorAccent</item>
        <item name="android:windowBackground">@color/white</item>
    </style>

    <!-- Base brand style (Using real Syne font) -->
    <style name="BrandTextStyle">
        <item name="android:textSize">42sp</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:fontFamily">@font/syne</item>
    </style>

    <!-- Štýl pre brand nápis Singer (ExtraBold / 800) -->
    <style name="BrandTextStyle.Singer">
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">800</item>
        <item name="android:textColor">@color/brand_singer</item>
    </style>

    <!-- Štýl pre brand nápis Land (Regular / 400) -->
    <style name="BrandTextStyle.Land">
        <item name="android:textStyle">normal</item>
        <item name="android:textFontWeight">400</item>
        <item name="android:textColor">@color/brand_land</item>
    </style>
    </resources>
